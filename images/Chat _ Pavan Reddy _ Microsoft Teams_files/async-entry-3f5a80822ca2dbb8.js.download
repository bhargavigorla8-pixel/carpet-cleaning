  query AppsChannelDataPreloadQuery(
    # From ComponentsChatQueriesMessagesResultFragment
    $convId: ID!
    $replyChainId: String
    $clientMessageId: ID
    $cursor: MessagesCursorInput
    $deeplinkMessageId: ID
    $direction: String
    $includeRepliesSummary: Boolean = false
    $includeStreamDraft: Boolean = false
    $channelMeetingId: ID
    $platformTabsEntryPoint: PlatformTabsEntryPoint
    # From ChannelHeaderQuery
    $conversationId: ID!
    $teamId: ID!
    $parentTeamId: ID!
    $fetchTeam: Boolean = false
    $fetchTabs: Boolean = false
    $fetchRedDot: Boolean = false
    $enableReflow: Boolean = false
    # From ComponentsChannelQueriesChannelByIdQuery
    $enableDiverseEmotionsNonreactive: Boolean = false
    $includeRepliesSummaryNonreactive: Boolean = false
    # From ComponentsSharedWithTeamsTableSharedWithTeams
    $channelId: ID!
    $queryInput: ReplyChainSummaryQueryInput
    $shouldResolveRecentUsers: Boolean! = true
    $first: Int = 20
    $after: String
    $last: Int = 20
    $before: String
    $enablePreferencesResolutionQuery: Boolean! = false
    $enablePostReplyChannelL1BroadQuery: Boolean = false
    $enableTabsData: Boolean = false
    $enableBuiltInTabsData: Boolean = false
  ) {
    # Do NOT add any field selections here, unless those fields are being used in this file!
    #
    # Instead, either add the field selections to the existing fragments below that are closest to
    # where you will be using those fields, or add a new fragment here that is colocated to your
    # new feature.
    #
    channelByID(conversationId: $convId) {
      # Channel type + thread modality are read in extractTelemetryData below to
      # slice interaction_data_prefetch latency by shared/standard/private and by
      # conversational/post-reply modality.
      channelType
      chatModality
      ...ChannelHeader_channel
      ...ComponentsChannelQueriesChannelByIdFragment
      ...ComponentsHeaderSearchGetChannelByIdFragment
      ...ComponentsPlatformGetHeaderTabsGetChannelFragment
    }
    team(teamThreadId: $parentTeamId, activitiesFromWorker: false)
      @include(if: $fetchTeam) {
      ...ChannelHeaderLayout_parentTeamFragment
    }
    ...ComponentsChatQueriesMessagesResultFragment
    streamDraft(
      convId: $convId
      clientMessageId: $clientMessageId
      replyChainId: $replyChainId
    ) @include(if: $includeStreamDraft) {
      ...ComponentsDraftFragmentsStreamDraftFragment
    }
    ...ComponentsChannelPaneReplyChainSummariesFragment
      @include(if: $enablePostReplyChannelL1BroadQuery)
    ...novaCollaborativeTabs_CollaborativeTabConnection
      @arguments(conversationId: $convId)
      @include(if: $enableTabsData)
    ...novaCollaborativeTabs_CollaborativeBuiltInTabConnection
      @arguments(conversationId: $conversationId)
      @include(if: $enableBuiltInTabsData)
  }
